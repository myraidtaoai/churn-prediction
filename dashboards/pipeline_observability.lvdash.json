{
  "datasets": [
    {
      "displayName": "Recent pipeline runs",
      "name": "recent_runs",
      "queryLines": [
        "SELECT task_name, run_id, status, started_at, finished_at, duration_seconds, output_summary, error_message\n",
        "FROM pipeline_runs\n",
        "ORDER BY started_at DESC\n",
        "LIMIT 100"
      ]
    },
    {
      "displayName": "Run counts by task and status",
      "name": "run_counts",
      "queryLines": [
        "SELECT task_name, status, COUNT(*) AS runs\n",
        "FROM pipeline_runs\n",
        "GROUP BY task_name, status\n",
        "ORDER BY task_name, status"
      ]
    },
    {
      "displayName": "Average duration by task",
      "name": "avg_duration",
      "queryLines": [
        "SELECT task_name, ROUND(AVG(duration_seconds), 1) AS avg_duration_s, ROUND(MAX(duration_seconds), 1) AS max_duration_s, COUNT(*) AS runs\n",
        "FROM pipeline_runs\n",
        "WHERE status = 'succeeded'\n",
        "GROUP BY task_name\n",
        "ORDER BY avg_duration_s DESC"
      ]
    },
    {
      "displayName": "Daily run timeline",
      "name": "daily_timeline",
      "queryLines": [
        "SELECT DATE(started_at) AS run_date, task_name, COUNT(*) AS runs, SUM(CASE WHEN status = 'failed' THEN 1 ELSE 0 END) AS failures\n",
        "FROM pipeline_runs\n",
        "GROUP BY DATE(started_at), task_name\n",
        "ORDER BY run_date DESC, task_name"
      ]
    },
    {
      "displayName": "Duration trend",
      "name": "duration_trend",
      "queryLines": [
        "SELECT DATE(started_at) AS run_date, task_name, ROUND(AVG(duration_seconds), 1) AS avg_duration_s\n",
        "FROM pipeline_runs\n",
        "WHERE status = 'succeeded'\n",
        "GROUP BY DATE(started_at), task_name\n",
        "ORDER BY run_date, task_name"
      ]
    },
    {
      "displayName": "Total runs",
      "name": "total_runs",
      "queryLines": [
        "SELECT COUNT(*) AS total_runs\n",
        "FROM pipeline_runs"
      ]
    },
    {
      "displayName": "Failed runs",
      "name": "failed_runs",
      "queryLines": [
        "SELECT COUNT(*) AS failed_runs\n",
        "FROM pipeline_runs\n",
        "WHERE status = 'failed'"
      ]
    },
    {
      "displayName": "Success rate",
      "name": "success_rate",
      "queryLines": [
        "SELECT ROUND(SUM(CASE WHEN status = 'succeeded' THEN 1.0 ELSE 0.0 END) / COUNT(*), 4) AS success_rate\n",
        "FROM pipeline_runs"
      ]
    },
    {
      "displayName": "Latest run per task",
      "name": "latest_per_task",
      "queryLines": [
        "WITH ranked AS (\n",
        "  SELECT task_name, status, started_at, duration_seconds, output_summary, error_message,\n",
        "         ROW_NUMBER() OVER (PARTITION BY task_name ORDER BY started_at DESC) AS rn\n",
        "  FROM pipeline_runs\n",
        ")\n",
        "SELECT task_name, status, started_at AS last_run, duration_seconds, output_summary, error_message\n",
        "FROM ranked WHERE rn = 1\n",
        "ORDER BY task_name"
      ]
    },
    {
      "displayName": "Recent failures",
      "name": "recent_failures",
      "queryLines": [
        "SELECT task_name, run_id, started_at, duration_seconds, error_message\n",
        "FROM pipeline_runs\n",
        "WHERE status = 'failed'\n",
        "ORDER BY started_at DESC\n",
        "LIMIT 20"
      ]
    },
    {
      "displayName": "Data quality summary",
      "name": "dq_summary",
      "queryLines": [
        "SELECT rule_name, severity, stage, SUM(total_rows) AS total_rows, SUM(passing_rows) AS passing_rows, SUM(violating_rows) AS violating_rows,\n",
        "       ROUND(SUM(passing_rows) * 1.0 / NULLIF(SUM(total_rows), 0), 4) AS pass_rate\n",
        "FROM data_quality_metrics\n",
        "GROUP BY rule_name, severity, stage\n",
        "ORDER BY pass_rate ASC"
      ]
    },
    {
      "displayName": "Data quality trend",
      "name": "dq_trend",
      "queryLines": [
        "SELECT DATE(evaluated_at) AS eval_date, SUM(violating_rows) AS violations, SUM(total_rows) AS total_rows,\n",
        "       ROUND(SUM(passing_rows) * 1.0 / NULLIF(SUM(total_rows), 0), 4) AS pass_rate\n",
        "FROM data_quality_metrics\n",
        "GROUP BY DATE(evaluated_at)\n",
        "ORDER BY eval_date"
      ]
    },
    {
      "displayName": "Promotion history",
      "name": "promotion_history",
      "queryLines": [
        "SELECT candidate_version, champion_version, decision, decision_reason, candidate_pr_auc, champion_pr_auc, evaluated_at\n",
        "FROM model_promotion_history\n",
        "ORDER BY evaluated_at DESC\n",
        "LIMIT 20"
      ]
    }
  ],
