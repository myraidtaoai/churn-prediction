{
  "datasets": [
    {
      "displayName": "Customer overview",
      "name": "customer_overview",
      "queryLines": [
        "SELECT s.customer_id, s.contract, s.internet_service, s.payment_method, s.tenure, s.monthly_charges, s.churn_label, c.churn_probability, c.risk_segment, c.annual_revenue_at_risk\n",
        "FROM telco_silver s\n",
        "INNER JOIN current_customer_churn_scores c USING (customer_id)"
      ]
    },
    {
      "displayName": "High-risk customer summary",
      "name": "high_risk_summary",
      "queryLines": [
        "SELECT CAST(COALESCE(SUM(CASE WHEN risk_segment = 'High' THEN 1 ELSE 0 END), 0) AS BIGINT) AS high_risk_customers\n",
        "FROM current_customer_churn_scores"
      ]
    },
    {
      "displayName": "Risk by contract",
      "name": "risk_by_contract",
      "queryLines": [
        "SELECT s.contract AS contract, COUNT(*) AS customers, AVG(s.churn_label) AS actual_churn_rate, AVG(c.churn_probability) AS predicted_churn_probability\n",
        "FROM telco_silver s INNER JOIN current_customer_churn_scores c USING (customer_id)\n",
        "GROUP BY s.contract\n",
        "ORDER BY predicted_churn_probability DESC"
      ]
    },
    {
      "displayName": "Model validation metrics",
      "name": "model_metrics",
      "queryLines": [
        "SELECT selected_algorithm, model_name, model_version, trained_at, validation_pr_auc, test_roc_auc, test_pr_auc, test_precision, test_recall, test_f1, test_balanced_accuracy, test_rows, classification_threshold\n",
        "FROM model_validation_metrics"
      ]
    },
    {
      "displayName": "Highest-risk customer action list",
      "name": "high_risk_customers",
      "queryLines": [
        "SELECT customer_id, contract, tenure, monthly_charges, churn_probability, risk_segment, annual_revenue_at_risk\n",
        "FROM current_customer_churn_scores\n",
        "ORDER BY CASE risk_segment WHEN 'High' THEN 0 WHEN 'Medium' THEN 1 ELSE 2 END, churn_probability DESC\n",
        "LIMIT 25"
      ]
    },
    {
      "displayName": "SHAP feature importance",
      "name": "shap_feature_importance",
      "queryLines": [
        "SELECT feature, mean_abs_shap, directional_mean_shap\n",
        "FROM shap_feature_importance\n",
        "ORDER BY mean_abs_shap DESC\n",
        "LIMIT 12"
      ]
    },
    {
      "displayName": "Churn by tenure band",
      "name": "churn_by_tenure",
      "queryLines": [
        "WITH segmented AS (\n",
        "  SELECT CASE WHEN tenure <= 6 THEN '0–6' WHEN tenure <= 12 THEN '7–12' WHEN tenure <= 24 THEN '13–24' WHEN tenure <= 48 THEN '25–48' ELSE '49–72' END AS tenure_band,\n",
        "         CASE WHEN tenure <= 6 THEN 1 WHEN tenure <= 12 THEN 2 WHEN tenure <= 24 THEN 3 WHEN tenure <= 48 THEN 4 ELSE 5 END AS band_order,\n",
        "         churn_label, monthly_charges\n",
        "  FROM telco_silver\n",
        ")\n",
        "SELECT tenure_band, band_order, COUNT(*) AS customers, AVG(churn_label) AS churn_rate, AVG(monthly_charges) AS avg_monthly_charges\n",
        "FROM segmented\n",
        "GROUP BY tenure_band, band_order\n",
        "ORDER BY band_order"
      ]
    },
    {
      "displayName": "Churn by payment method",
      "name": "churn_by_payment_method",
      "queryLines": [
        "SELECT payment_method, COUNT(*) AS customers, AVG(churn_label) AS churn_rate, AVG(monthly_charges) AS avg_monthly_charges\n",
        "FROM telco_silver\n",
        "GROUP BY payment_method\n",
        "ORDER BY churn_rate DESC"
      ]
    },
    {
      "displayName": "Revenue risk by segment",
      "name": "revenue_risk_by_segment",
      "queryLines": [
        "SELECT risk_segment, COUNT(*) AS customers, AVG(churn_probability) AS average_churn_probability, SUM(annual_revenue_at_risk) AS annual_revenue_at_risk\n",
        "FROM current_customer_churn_scores\n",
        "GROUP BY risk_segment\n",
        "ORDER BY CASE risk_segment WHEN 'High' THEN 1 WHEN 'Medium' THEN 2 ELSE 3 END"
      ]
    },
    {
      "displayName": "Predicted versus observed churn by score decile",
      "name": "predicted_vs_observed_deciles",
      "queryLines": [
        "WITH deciles AS (\n",
        "  SELECT s.churn_label, c.churn_probability, NTILE(10) OVER (ORDER BY c.churn_probability) AS score_decile\n",
        "  FROM telco_silver s INNER JOIN current_customer_churn_scores c USING (customer_id)\n",
        "), summary AS (\n",
        "  SELECT score_decile, AVG(churn_probability) AS predicted_rate, AVG(churn_label) AS observed_rate\n",
        "  FROM deciles GROUP BY score_decile\n",
        ")\n",
        "SELECT score_decile, 'Predicted probability' AS series, predicted_rate AS rate FROM summary\n",
        "UNION ALL\n",
        "SELECT score_decile, 'Observed churn' AS series, observed_rate AS rate FROM summary\n",
        "ORDER BY score_decile, series"
      ]
    },
    {
      "displayName": "Champion test scorecard",
      "name": "test_metric_scorecard",
      "queryLines": [
        "SELECT 'PR-AUC' AS metric, test_pr_auc AS value, 1 AS metric_order FROM model_validation_metrics\n",
        "UNION ALL SELECT 'ROC-AUC', test_roc_auc, 2 FROM model_validation_metrics\n",
        "UNION ALL SELECT 'Precision', test_precision, 3 FROM model_validation_metrics\n",
        "UNION ALL SELECT 'Recall', test_recall, 4 FROM model_validation_metrics\n",
        "UNION ALL SELECT 'F1', test_f1, 5 FROM model_validation_metrics\n",
        "UNION ALL SELECT 'Balanced accuracy', test_balanced_accuracy, 6 FROM model_validation_metrics\n",
        "ORDER BY metric_order"
      ]
    },
    {
      "displayName": "Churn by internet service",
      "name": "churn_by_internet_service",
      "queryLines": [
        "SELECT internet_service, COUNT(*) AS customers, AVG(churn_label) AS churn_rate, AVG(monthly_charges) AS avg_monthly_charges\n",
        "FROM telco_silver\n",
        "GROUP BY internet_service\n",
        "ORDER BY churn_rate DESC"
      ]
    },
    {
      "displayName": "Churn by monthly-charge band",
      "name": "churn_by_charge_band",
      "queryLines": [
        "WITH bands AS (\n",
        "  SELECT CASE WHEN monthly_charges < 35 THEN 'Under $35' WHEN monthly_charges < 65 THEN '$35–64' WHEN monthly_charges < 90 THEN '$65–89' ELSE '$90+' END AS charge_band,\n",
        "         CASE WHEN monthly_charges < 35 THEN 1 WHEN monthly_charges < 65 THEN 2 WHEN monthly_charges < 90 THEN 3 ELSE 4 END AS band_order, churn_label\n",
        "  FROM telco_silver\n",
        ")\n",
        "SELECT charge_band, band_order, COUNT(*) AS customers, AVG(churn_label) AS churn_rate\n",
        "FROM bands GROUP BY charge_band, band_order ORDER BY band_order"
      ]
    },
    {
      "displayName": "Revenue risk concentration",
      "name": "risk_concentration",
      "queryLines": [
        "SELECT s.contract, c.risk_segment, COUNT(*) AS customers, SUM(c.annual_revenue_at_risk) AS annual_revenue_at_risk\n",
        "FROM telco_silver s INNER JOIN current_customer_churn_scores c USING (customer_id)\n",
        "GROUP BY s.contract, c.risk_segment\n",
        "ORDER BY annual_revenue_at_risk DESC"
      ]
    },
    {
      "displayName": "Candidate model trade-off",
      "name": "candidate_tradeoff",
      "queryLines": [
        "SELECT algorithm, 'Validation PR-AUC' AS metric, validation_pr_auc AS value FROM model_comparison_metrics\n",
        "UNION ALL\n",
        "SELECT algorithm, 'Validation best F1' AS metric, validation_best_f1 AS value FROM model_comparison_metrics\n",
        "ORDER BY algorithm, metric"
      ]
    }
  ],
